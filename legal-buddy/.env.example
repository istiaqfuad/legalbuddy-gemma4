# ── Embedding (required) ─────────────────────────────────────────────────────
# Sentence-transformers model run locally (CPU). intfloat/multilingual-e5-base
# was A/B-validated: it roughly doubled retrieval metrics vs the original model.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Optional: override the embedding model's max token window (default = model's own).
# Only set if you know the checkpoint supports a larger window than it advertises.
EMBEDDING_MAX_TOKENS=512
HF_TOKEN=

# ── Vector store (qdrant service in docker-compose.full.yml) ────────────────
QDRANT_VECTORESTORE=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_acts_event_rag_full

# ── LLM: any OpenAI-compatible endpoint, switched by env only ────────────────
# DEFAULT_LLM_PROVIDER selects the backend: "groq" (== any OpenAI-compatible
# /v1/chat/completions server: Groq cloud, llama.cpp, vLLM, LM Studio) or
# "gemini". The two setups below need NO code changes — just these variables.
#
# ── Option A: local fine-tuned Gemma 4 (llama.cpp in docker-compose.full.yml) ─
DEFAULT_LLM_PROVIDER=groq
GROQ_BASE_URL=http://llm:8080/v1
GROQ_MODEL=lawbuddy-gemma4          # must equal the llama.cpp --alias
GROQ_API_KEY=local                  # llama.cpp ignores keys; variable must be set
# Optional distinct rewrite model — REQUIRED to be empty for llama.cpp (single
# model server); set only when the endpoint serves multiple models:
GROQ_CONDENSE_MODEL=
# Total timeout (s) for OpenAI-compatible calls — llama.cpp binds its port only
# after the model loads, and CPU-only servers take minutes to first token:
GROQ_TIMEOUT_SECONDS=300
#
# ── Option B: Groq cloud (quick demo/testing without local GPU) ──────────────
# DEFAULT_LLM_PROVIDER=groq
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk-...
# GROQ_CONDENSE_MODEL=llama-3.1-8b-instant
#
# ── Option C (dev only — the competition demo must run on Gemma 4): Gemini ──
# DEFAULT_LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# ── Conversation / generation defaults ──────────────────────────────────────
# Optional. Leave empty/unset to let model default behavior apply.
ANSWER_MAX_TOKENS=
# Retrieval top-k; two-tier clarify control (see config.py for the reasoning).
RETRIEVAL_TOP_K=8
CLARIFY_SCORE_FLOOR=0.79
LOW_CONFIDENCE_FLOOR=0.83

# ── Optional observability (LangSmith) ──────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=legal-buddy
LANGSMITH_API_KEY=
# Required only for org-scoped API keys:
LANGSMITH_WORKSPACE_ID=

# ── Optional / future ───────────────────────────────────────────────────────
POSTGRES_CONNECTION_STRING=
